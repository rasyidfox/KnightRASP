<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
            Attaches the default runtime (probes + all checks) to the Rasp facade
            before Application.onCreate runs, so the app only needs to call
            Rasp.init(this, config).
        -->
        <provider
            android:name="io.knightrasp.internal.KnightRASPInitProvider"
            android:authorities="${applicationId}.knightrasp-init"
            android:exported="false"
            android:initOrder="100" />

    </application>

</manifest>
